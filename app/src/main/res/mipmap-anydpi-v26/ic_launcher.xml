<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面图标（Android 8.0+）：自适应图标 -->
<!-- 底色 = 纯白（drawable/ic_launcher_background），前景 = 用户提供的图标位图
     （mipmap-xxxhdpi/ic_launcher_foreground.png，原图缩进 72dp 安全区居中，
      圆形 / 方圆任何遮罩都裁不到主体）；遮罩形状（圆形、方圆、水滴…）由桌面决定。
     不再带 monochrome 单色层：位图没有可挖的剪影，主题图标直接回退用这张正常图标 -->
<!-- anydpi 保证它优先于 mipmap-xxxhdpi/ic_launcher.png（传统回退图，只给 API 23–25 用） -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
