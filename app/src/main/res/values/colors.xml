<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色主题语义色令牌。深色覆盖见 values-night/colors.xml。 -->
<resources>
    <!-- 页面底色（不再有壁纸照片，整页就是这一个实色） -->
    <color name="page_background">#f2f3f5</color>
    <!-- 卡片表面：比页面亮一档，靠明度差 + 一道发丝线把卡片立起来 -->
    <color name="surface">#ffffff</color>
    <!-- 卡片与标题栏的发丝线 -->
    <color name="card_stroke">#1f000000</color>

    <color name="text_primary">#1b1d1b</color>
    <!-- 次要文字全部落在卡片上，比常规 60% 灰更暗一档，保证小字号副标题 ≥4.5:1 -->
    <color name="text_secondary">#333c37</color>

    <color name="accent_cainiao">#147848</color>
    <color name="accent_taobao">#c24b12</color>
    <color name="accent_pinduoduo">#be233c</color>
    <!-- 京东待取快递：品牌红，白字 4.69:1 -->
    <color name="accent_jd">#e1251b</color>
    <!-- 小红书待取快递：官方红 #ff2442 配白字只有 3.76:1，压暗到此值取 5.03:1 -->
    <color name="accent_xhs">#d81e3f</color>
    <!-- 抖音待取快递：用抖音的品牌深色（App 图标就是黑底），白字 17:1 -->
    <!-- 官方红 #fe2c55 配白字只有 3.68:1，达不到本工程标准，故不用 -->
    <color name="accent_douyin">#161823</color>
    <!-- 得物待取快递：得物品牌青压暗到 5.2:1（原色太亮，白字对比度不够） -->
    <color name="accent_dewu">#0b7a72</color>

    <!-- 日常常用：微信 / 支付宝品牌色（行图标回退底、涟漪色） -->
    <color name="accent_wechat">#07c160</color>
    <color name="accent_alipay">#1677ff</color>

    <!-- 小组件按钮的按压反馈：RemoteViews 里没有涟漪，用一层低透明度实底代替 -->
    <color name="widget_press_tint">#14000000</color>
</resources>
