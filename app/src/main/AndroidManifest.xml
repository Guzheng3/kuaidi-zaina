<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kuaidi.qinghan.vip"
    android:versionCode="3"
    android:versionName="1.0.2">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35" />

    <!-- Android 11+ 包可见性：必须声明要查询的 App 与 deep link scheme。 -->
    <!-- 缺少这些声明时 PackageManager#resolveActivity() 会一律返回 null。 -->
    <queries>
        <package android:name="com.cainiao.wireless" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.jingdong.app.mall" />
        <package android:name="com.xingin.xhs" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.shizhuang.duapp" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.eg.android.AlipayGphone" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 菜鸟：桌面 / 驿站身份码 -->
            <data android:scheme="cainiao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 菜鸟：guoguo 唤起协议（IdentityCodeActivity 真实声明） -->
            <data android:scheme="guoguo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 淘宝：tbopen 唤起协议 -->
            <data android:scheme="tbopen" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 淘宝：taobao 唤起协议 -->
            <data android:scheme="taobao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 拼多多：mdkd 唤起协议 -->
            <data android:scheme="pinduoduo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 京东：openjd 唤起协议 -->
            <data android:scheme="openjd" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 小红书：xhsdiscover 唤起协议 -->
            <data android:scheme="xhsdiscover" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 抖音：snssdk1128 唤起协议（订单页走 //mall/xtab 内部路由） -->
            <data android:scheme="snssdk1128" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- 得物：dewuapp 唤起协议（订单页走 m.dewu.com/router 路由） -->
            <data android:scheme="dewuapp" />
        </intent>
    </queries>

    <!-- 桌面图标取 mipmap：v26+ 命中自适应图标（mipmap-anydpi-v26/），
         更低版本落到传统图标（mipmap/），由资源限定符自动分流，这里不需要判断版本。
         roundIcon 单独指向正圆版本：7.1 的圆形桌面不再裁形，方图会被压成方的 -->
    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="kuaidi.qinghan.vip.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- 桌面图标入口：action 为空时展示主页 -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name="kuaidi.qinghan.vip.PickupWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pickup_widget_info" />
        </receiver>
    </application>
</manifest>
