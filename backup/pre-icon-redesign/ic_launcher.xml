<?xml version="1.0" encoding="utf-8"?>
<!-- 应用图标：浅底 + 三根取件条（菜鸟绿 / 淘宝橙 / 拼多多红） -->
<!-- 108dp 方图，与 AppTheme 的 PAGE_BACKGROUND 同色，桌面观感统一 -->
<!-- 三根竖条分别对应三个取件入口，颜色与主页 accent_* 强调色一致 -->
<!-- 直接作为 vector 使用，圆形图标（roundIcon）也复用同一份 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android" android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
<!-- 底色 -->
<!-- 铺满整个 viewport，避免桌面图标出现透明边 -->
    <path android:fillColor="#f7f8f4" android:pathData="M0,0h108v108h-108z" />
<!-- 菜鸟 -->
<!-- 19..39 -->
    <path android:fillColor="#147848" android:pathData="M19,28h20v52h-20z" />
<!-- 淘宝 -->
<!-- 44..64 -->
    <path android:fillColor="#c24b12" android:pathData="M44,28h20v52h-20z" />
<!-- 拼多多 -->
<!-- 69..89 -->
    <path android:fillColor="#be233c" android:pathData="M69,28h20v52h-20z" />
</vector>
